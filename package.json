{
  "name": "shisui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "把群消息里散落的截止时间捡起来：解析成带绝对时间的待办，并自动体检冲突。纯前端、本地优先，公司群/项目群/班级群通用。",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "schedule",
    "todo",
    "time-parser",
    "chinese-nlp",
    "local-first",
    "offline-first",
    "react",
    "typescript",
    "vite",
    "dexie"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dream-office/shisui.git"
  },
  "homepage": "https://dream-office.github.io/shisui/",
  "bugs": {
    "url": "https://github.com/dream-office/shisui/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:core": "node scripts/smoke-core-import.mjs",
    "check": "pnpm typecheck && pnpm test",
    "deploy:pages": "tsc -b && vite build && node scripts/publish-pages.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shisui-core": "workspace:*",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  }
}
