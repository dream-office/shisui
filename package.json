{
  "name": "kedaibiao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把班级群 / 教务通知粘贴进来，解析成带绝对时间的待办清单，并自动体检冲突。纯前端、本地优先。",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "schedule",
    "todo",
    "time-parser",
    "chinese-nlp",
    "local-first",
    "offline-first",
    "react",
    "typescript",
    "vite",
    "dexie"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dream-office/kedaibiao.git"
  },
  "homepage": "https://dream-office.github.io/kedaibiao/",
  "bugs": {
    "url": "https://github.com/dream-office/kedaibiao/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test",
    "deploy": "pnpm build && node scripts/publish-pages.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  }
}
